FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server python3 python3-venv python3-pip git curl \
 && rm -rf /var/lib/apt/lists/* && mkdir /run/sshd
RUN usermod -p '*' ubuntu && mkdir -p /home/ubuntu/.ssh
COPY test_key.pub /home/ubuntu/.ssh/authorized_keys
RUN chown -R ubuntu:ubuntu /home/ubuntu/.ssh && chmod 700 /home/ubuntu/.ssh && chmod 600 /home/ubuntu/.ssh/authorized_keys
CMD ["/usr/sbin/sshd", "-D"]